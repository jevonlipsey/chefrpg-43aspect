<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="safehelper/SafeHelper.dll" />
    <Compile Remove="safehelper/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- the verifier ships inside the patcher so every output is gated on it. verify/Program.cs
         (the standalone harness entry point) is deliberately not linked. DisplayPolicy.cs sits
         in safehelper/, which is removed above, so it is linked explicitly -->
    <Compile Include="../verify/Checks.cs" Link="verify/Checks.cs" />
    <Compile Include="../verify/IlVerifier.cs" Link="verify/IlVerifier.cs" />
    <Compile Include="../verify/SemanticVerifier.cs" Link="verify/SemanticVerifier.cs" />
    <Compile Include="../verify/Simulator.cs" Link="verify/Simulator.cs" />
    <Compile Include="../verify/VerifyRunner.cs" Link="verify/VerifyRunner.cs" />
    <Compile Include="safehelper/DisplayPolicy.cs" Link="verify/DisplayPolicy.cs" />
  </ItemGroup>

</Project>
